# Wird auf dem Server von scripts/bootstrap_server.sh nach .env kopiert, Passwörter
# und JWT-Secret werden dort zufällig erzeugt. Die echte .env nie committen.

# Datenbank (docker-compose: Backend + MySQL)
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=hr3000
MYSQL_USER=hr3000
MYSQL_PASSWORD=changeme

JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256

# Schlüssel (Fernet) für verschlüsselte Personalakte-Dokumente und SMTP-Passwörter.
# Erzeugen: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ACHTUNG: Ohne diesen Schlüssel sind Dokumente und gespeicherte SMTP-Passwörter nicht
# wiederherstellbar – zusammen mit dem Backup (aber getrennt aufbewahrt) sichern!
ENCRYPTION_KEY=changeme-generate-a-fernet-key

# Produktion: immer false (true würde den X-Tenant-Subdomain-Header zulassen)
DEBUG=false

# E-Mail des plattformweiten Super-Admins (wird bei der ersten Migration angelegt)
SUPER_ADMIN_EMAIL=admin@example.com

# Plattform-Domain: jeder Mandant automatisch unter <subdomain>.<domain> und
# kiosk.<subdomain>.<domain> (Zertifikat beim ersten Aufruf). DNS: ein A-Record "*" auf den
# Server (bei Cloudflare "Nur DNS"). Leer = nur die festen Hosts unten.
# Selbstregistrierung auf der Website (nur mit Plattform-Domain), Grenzen je IP und pro Tag:
# SELF_SIGNUP_ENABLED=true
# SELF_SIGNUP_PER_IP_PER_DAY=3
# SELF_SIGNUP_PER_DAY=20
TENANT_BASE_DOMAIN=hr.example.com

# Super-Admin-Bereich. Unter der Plattform-Domain läuft er über die Wildcard; liegt er
# außerhalb, zusätzlich in HR_HOSTS eintragen (siehe Caddyfile).
SUPER_ADMIN_HOSTNAME=admin.hr.example.com

# Zusätzliche feste Mandanten-Hosts außerhalb der Plattform-Domain (siehe Caddyfile) –
# kommagetrennt, je Host ein A-Record. Der erste Hostname-Teil ist die Mandanten-Subdomain.
# Testumgebung auf demselben Server (scripts/staging.sh setup trägt das selbst ein); leer = keine
# STAGING_BASE_DOMAIN=test.example.com
HR_HOSTS=firma.hr-alt.example.com
KIOSK_HOSTS=firma.kiosk.hr-alt.example.com

# Optionaler E-Mail-Versand für Benachrichtigungen (ohne SMTP_HOST nur In-App)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
